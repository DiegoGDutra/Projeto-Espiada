# Copie para .env e ajuste. O docker compose lê este arquivo sozinho.

# Chave que assina o cookie de login. Sem ela, reiniciar o container desloga todo mundo.
# Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# LLM. Padrão: o Ollama instalado no computador. Com o Ollama em container (--profile ollama), use http://ollama:11434
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:4b

# Só para rodar o app fora do Docker. Dentro do Docker, o endereço do banco é definido no docker-compose.yml.
# DATABASE_URL=postgresql://espiada:espiada@127.0.0.1:5432/espiada
